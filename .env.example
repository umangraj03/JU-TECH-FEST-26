# Environment Configuration for AI Agent Security Guard
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEMO_MODE=true

# Principal Bearer Tokens
TOKEN_REQUESTER=token-requester-secret-key-101
TOKEN_APPROVER=token-approver-secret-key-202
TOKEN_ADMIN=token-admin-secret-key-303

# Database & Sandbox Storage
DATABASE_URL=sqlite:///./security_guard.db
SANDBOX_DIR=./sandbox_storage

# Limits & Windows
APPROVAL_TIMEOUT_SECONDS=900
MAX_EGRESS_BYTES_PER_SESSION=5000
RATE_LIMIT_PER_MINUTE=60
